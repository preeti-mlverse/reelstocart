# ============================================================================
# Reel-to-Cart — environment template. Copy to .env and fill in.
# NEVER commit a real .env. No secret values belong in this file.
# ============================================================================

# --- Runtime mode -----------------------------------------------------------
# One of: DEVELOPMENT_MOCK | REAL_LOCAL | REAL_HOSTED
# DEVELOPMENT_MOCK  -> no external spend, deterministic fake model outputs
# REAL_LOCAL        -> local open-weight models (GPU/CPU), no hosted API spend
# REAL_HOSTED       -> hosted inference APIs (incurs cost; requires budget caps)
RTC_MODE=DEVELOPMENT_MOCK
NODE_ENV=development
LOG_LEVEL=info

# --- Web app ----------------------------------------------------------------
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Vision service (FastAPI) ----------------------------------------------
VISION_SERVICE_URL=http://localhost:8000
VISION_PORT=8000

# --- Database (Postgres + pgvector) ----------------------------------------
# Host port is configurable to avoid clashes with other local Postgres instances.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://rtc:rtc_dev_password@localhost:5432/reeltocart
POSTGRES_USER=rtc
POSTGRES_PASSWORD=rtc_dev_password
POSTGRES_DB=reeltocart
# Use the pgvector HNSW ANN path for retrieval (else in-process cosine over seed embeddings).
USE_PGVECTOR=false

# --- Redis (queues / rate limits / cache) ----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Object storage (S3-compatible; MinIO for local) -----------------------
STORAGE_PROVIDER=local            # local | s3 | minio
STORAGE_BUCKET=rtc-media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
# Signed URL TTL (seconds) and media auto-expiry (seconds)
STORAGE_SIGNED_URL_TTL=900
MEDIA_RETENTION_SECONDS=86400

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=2592000
GUEST_RATE_LIMIT_PER_HOUR=10
USER_RATE_LIMIT_PER_HOUR=100

# --- Media ingestion limits -------------------------------------------------
MAX_UPLOAD_BYTES=104857600        # 100 MB
MAX_VIDEO_DURATION_SECONDS=120
MAX_IMAGE_DIMENSION=8000          # px (guards decompression bombs)
MAX_VIDEO_FRAMES=1800

# --- Social providers (metadata/embed ONLY unless terms permit media) ------
# Leave blank to run in PREVIEW_ONLY/embed mode. Do NOT scrape.
INSTAGRAM_OEMBED_ENABLED=false
YOUTUBE_API_KEY=                  # YouTube Data API v3 (metadata/oEmbed)
YOUTUBE_OEMBED_ENABLED=true

# --- Hosted AI providers (REAL_HOSTED only) --------------------------------
# Primary VLM for garment detection + attribute extraction (Strategy A).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: used for text embeddings / fallback VLM. Leave blank to skip.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Google OAuth (sign-in with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional open-weight hosting
REPLICATE_API_TOKEN=
HUGGINGFACE_TOKEN=

# --- Cost controls (hard circuit breakers) ---------------------------------
COST_MONTHLY_BUDGET_USD=50
COST_PER_SEARCH_CEILING_USD=0.25
COST_ALERT_THRESHOLD_PCT=80

# --- Affiliate / commerce (optional) ---------------------------------------
AFFILIATE_NETWORK_ID=

# --- Web: SEO / site (NEXT_PUBLIC_* are baked in at `next build` time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Only "true" on production. Anything else => robots Disallow: / + noindex everywhere.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Shows the "demo catalogue" banner on the home page until real merchant feeds are live.
NEXT_PUBLIC_DEMO_CATALOGUE=true
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=

# --- Web: admin dashboard (/admin, HTTP Basic). Unset password => admin disabled (404). ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Web: abuse/cost guard (requests per IP per minute) ---
ANALYZE_RATE_LIMIT_PER_MIN=10
ANALYZE_VIDEO_RATE_LIMIT_PER_MIN=4

# --- Search: visual near-duplicate threshold (calibrated: docs/eval/retrieval-latest.md) ---
RTC_NEAR_DUP_SIM=0.91
